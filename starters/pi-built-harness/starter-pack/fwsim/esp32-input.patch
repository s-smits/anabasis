         break;
-
-    default:
+    case 0x0c: case 0x18: case 0x28: case 0x34: case 0x4c: case 0x58: /* *_W1TC */
+        GPIO_REG(addr - 8) &= ~value;
         break;
+    default:
+        GPIO_REG(addr) = value;
     }
-    return r;
+    if (out != GPIO_REG(0x04) || out1 != GPIO_REG(0x10)) {
+        trace_esp32_gpio_out(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL), GPIO_REG(0x04), GPIO_REG(0x10));
+    }
+    esp32_gpio_update(s);
 }

