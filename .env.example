# The credentials a campaign's seats use. Copy this file to `.env`, which git ignores, fill in the
# providers you use, and pass it to Bun, which loads it into the command and hands it on:
#
#   bun --env-file=.env run runs status
#
# No campaign or agent opens this file; `bun run setup --token` can write it interactively in your
# terminal. A seat named `claude/<model>` runs Claude Code on the OAuth token, `claude-api/<model>`
# the API on the key, `openrouter/<model>` OpenRouter; Codex reads its own login under `CODEX_HOME`.

# Claude Code, from `claude setup-token` (or `bun run setup --token`): serves every seat at once.
CLAUDE_CODE_OAUTH_TOKEN=

# Further Claude Code logins, numbered. `bun run runs launch --login N` runs a campaign on
# CLAUDE_CODE_OAUTH_TOKEN<N>, and `bun run runs usage` reads each one's use.
CLAUDE_CODE_OAUTH_TOKEN2=

# The Anthropic API, for `claude-api/<model>`.
ANTHROPIC_API_KEY=

# OpenRouter, for `openrouter/<model>`.
OPENROUTER_API_KEY=
