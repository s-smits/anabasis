{
  "compilerOptions": {
    "target": "ES2025",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2025"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["bun"]
  },
  "include": [
    "src/**/*.ts",
    "tools/**/*.ts",
    "vendor/**/*.ts",
    "test/**/*.ts",
    "studies/**/*.ts",
    ".claude/**/*.ts"
  ],
  "exclude": ["**/node_modules", "**/dist"]
}
