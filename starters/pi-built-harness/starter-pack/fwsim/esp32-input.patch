+    }
+    if (!s->stimulus) {
+        return 0;
+    }
+    if (addr >= A_GPIO_ACPU_INT && addr <= A_GPIO_CPUSDIO_INT1) {
+        /* per-CPU views of the status: APP, APP NMI, PRO, PRO NMI, SDIO for each bank */
+        int hi = addr >= A_GPIO_ACPU_INT + 0x14;
