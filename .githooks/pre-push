#!/bin/sh
# A source push runs the repository's own gate over what it changed, instead of reimplementing its
# runtime admission, typecheck, lint, or test steps here. A push whose published tree differs only
# on the named documentation surfaces gets a diff check and stops. Every fresh commit the push
# publishes gets the gate's static steps and its nearby tests, because the history is read as well
# as run: an agent that finds a red commit followed by its repair learns that pushing red is the way
# work goes (operator decision 2026-09-24). A commit a rebase only carried to a new base waits for
# `bun run land`, which proves every commit where it sits before anything merges.
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

# Whether the diff from $1 to $2 touches anything beyond the documentation set, the surrounding
# text/evidence surfaces; further arguments are pathspecs the caller excludes as well. Scripts,
# fixtures, configuration and every source root remain outside the set even if their extension
# happens to be Markdown.
changes_source() (
  from=$1 to=$2
  shift 2
  ! git diff --quiet "$from" "$to" -- . \
    ':(exclude)AGENTS.md' \
    ':(exclude)README.md' \
    ':(exclude)docs/**' \
    ':(exclude).claude/**/*.md' \
    "$@"
)

# Brings each named commit into this clone when it is not here yet. One that cannot be fetched stays
# missing, and the check that needed it says so or steps aside.
fetch_missing() (
  for sha in "$@"; do
    git cat-file -e "$sha^{commit}" 2>/dev/null || git fetch -q origin "$sha" 2>/dev/null || true
  done
)

# A side pull request goes to main on its own, beside the open stack rather than on it (operator
# decision 2026-10-07). From where it leaves main's head on the remote ($main_head), it changes nothing
# beyond the documentation set, the skills, the tests, the skills' lock and the lint-exception register
# their scripts' rows live in. While main's head is unread, nothing is one.
side() (
  [ -n "$main_head" ] || exit 1
  fetch_missing "$main_head" "$1"
  fork=$(git merge-base "$main_head" "$1" 2>/dev/null) || exit 1
  ! changes_source "$fork" "$1" \
    ':(exclude).claude/**' \
    ':(exclude)test/**' \
    ':(exclude)skills-lock.json' \
    ':(exclude)tools/oxlint/not-slop.tsv'
)

# Git names the remote as the hook's two arguments; its URL is where a base branch's head is read.
remote_url=${2:-}

# Git hands the hook one line per ref on stdin: `<local ref> <local sha> <remote ref> <remote sha>`.
# A push that only deletes remote refs (local sha all zeros) publishes no bytes from this tree, so
# the gate has nothing to prove and would only hold the queue. New remote refs run the full gate:
# without a remote tree there is no stable documentation-only baseline.
publishes=0
published=""
heads=""
new_branches=""
moved=""
already_remote=""
documentation_only=1
documentation_diff_ok=1
# The gate tests this checkout, so the checkout is the tested identity. Reading it from the ref
# list instead made the name depend on the order Git happened to hand the refs over: pushing a
# parent and a composed tip together named whichever came last. Every published source ref must be
# contained in this tree, so the named commit describes the bytes the gate actually ran.
tested_commit=$(git rev-parse HEAD)
# Git names a ref that does not exist by the all-zeroes object name (githooks(5), pre-push); this is
# its own pre-push.sample's spelling, which takes the length from the repository's hash.
zero=$(git hash-object --stdin </dev/null | tr '[0-9a-f]' '0')
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_ref:-}" ] || continue
  case "$local_sha" in
  "$zero") ;;
  *)
    publishes=1
    published="$published $local_sha"
    moved="$moved $remote_ref:$local_sha"
    if ! git merge-base --is-ancestor "$local_sha" "$tested_commit"; then
      echo "pre-push: $local_ref ($local_sha) is not contained in the checked-out tree ($tested_commit)," >&2
      echo "pre-push: so the gate would prove other bytes. Check that commit out and push from there." >&2
      exit 1
    fi
    # Main takes documentation and hotfixes directly, and anything else reaches it as a pull request:
    # a side one on its own, the rest on the top of the open stack. A push to main that changes source
    # is a hotfix only when every commit it adds says so in a `Hotfix:` trailer giving the reason it
    # cannot wait for the stack.
    if [ "$remote_ref" = refs/heads/main ] && [ "$remote_sha" != "$zero" ] &&
      changes_source "$remote_sha" "$local_sha"; then
      for commit in $(git rev-list "$local_sha" --not "$remote_sha"); do
        [ -z "$(git log -1 --format='%(trailers:key=Hotfix,valueonly)' "$commit")" ] || continue
        echo "pre-push: main takes documentation and hotfixes alone; this push changes source, and" >&2
        echo "pre-push: $(git rev-parse --short=9 "$commit") has no Hotfix: trailer. Send it as a pull request, its own" >&2
        echo "pre-push: against main for a skill, test or documentation change and on the top of the open" >&2
        echo "pre-push: stack for any other, or, if it cannot wait for the stack, end each of its commits" >&2
        echo "pre-push: with a line \`Hotfix: <why>\`. Nothing was pushed." >&2
        exit 1
      done
    fi
    case "$remote_sha" in
    "$zero")
      documentation_only=0
      heads="$heads $local_sha"
      new_branches="$new_branches $local_sha"
      ;;
    *)
      # A branch someone else moved is not in this clone, and its old commits are then not known here.
      ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null || already_remote="$already_remote $remote_sha"
      git --no-pager diff --check "$remote_sha" "$local_sha" || documentation_diff_ok=0
      if changes_source "$remote_sha" "$local_sha"; then
        documentation_only=0
        heads="$heads $local_sha"
      fi
      ;;
    esac
    ;;
  esac
done
if [ "$publishes" -eq 0 ]; then
  echo "pre-push: every update is a deletion; nothing from this tree is published, so the gate is skipped." >&2
  exit 0
fi

# The sha this push leaves a branch at, or nothing when the push does not move it. GitHub still reports
# the old head of a branch the same push replays, so every stack check reads a moved branch here.
moved_to() {
  for update in $moved; do
    case "$update" in "refs/heads/$1:"*) echo "${update##*:}" && return ;; esac
  done
}

# A new branch is a new pull request. A side one goes to main on its own, and every other one on the
# top of the one open stack: it contains the head of the open pull request that no other open one is
# based on, side pull requests on main aside. The stack is read from GitHub; when it cannot be read,
# the check says so and steps aside rather than block.
main_head=""
[ -z "$new_branches" ] || [ -z "$remote_url" ] ||
  main_head=$(git ls-remote -q "$remote_url" refs/heads/main 2>/dev/null | cut -f1)
stacked=""
for sha in $new_branches; do side "$sha" || stacked="$stacked $sha"; done
if [ -n "$stacked" ]; then
  if tops=$(gh pr list --state open --limit 200 --json number,headRefName,baseRefName,headRefOid --jq \
    '[.[].baseRefName] as $bases | .[] | select(.headRefName as $h | $bases | any(. == $h) | not)
      | "#\(.number) \(.headRefName) \(.headRefOid) \(.baseRefName)"' 2>/dev/null); then
    tops=$(printf '%s\n' "$tops" | while read -r pr branch sha base; do
      [ -n "$pr" ] || continue
      head=$(moved_to "$branch")
      [ "$base" = main ] && side "${head:-$sha}" && continue
      echo "$pr $branch $sha"
    done)
    case $(printf '%s' "$tops" | grep -c . || true) in
    0) ;;
    1)
      read -r top_pr top_branch top_sha <<EOF
$tops
EOF
      top_moved=$(moved_to "$top_branch")
      top_sha=${top_moved:-$top_sha}
      for sha in $stacked; do
        ! git merge-base --is-ancestor "$top_sha" "$sha" 2>/dev/null || continue
        echo "pre-push: a new pull request goes on the top of the open stack, $top_pr ($top_branch), and" >&2
        echo "pre-push: $(git rev-parse --short=9 "$sha") does not contain its head. Nothing was pushed. Rebase it on" >&2
        echo "pre-push: origin/$top_branch after git fetch origin $top_branch, and open it with --base $top_branch." >&2
        exit 1
      done
      ;;
    *)
      echo "pre-push: the open pull requests have more than one top, so there is no single stack to" >&2
      echo "pre-push: put a new one on. Nothing was pushed. Base all but one of these on another:" >&2
      printf 'pre-push:   %s\n' "$tops" >&2
      exit 1
      ;;
    esac
  else
    echo "pre-push: the open pull requests could not be read from GitHub, so the stack check was skipped." >&2
  fi
fi

# An open pull request lists as its own every commit between its base and its head. Rewriting a base
# without replaying the pull requests on it therefore leaves each of them listing old copies of the
# base's commits beside its own, and a head that contains another open pull request's head beyond its
# base lists that one's commits too. So every pull request whose head or base this push moves is read
# as the push would leave it. A rebase keeps a commit's author time and subject, which is how an old
# copy is told from the commit that replaced it. The old copies are a warning: a push may carry the
# pull request being worked on alone, and `bun run land` refuses the stack until the ones above it
# are replayed. A head listing another pull request's commits is refused, because no replay fixes it.
if edges=$(gh pr list --state open --limit 200 --json number,headRefName,headRefOid,baseRefName,baseRefOid \
  --jq '.[] | "#\(.number) \(.headRefName) \(.headRefOid) \(.baseRefName) \(.baseRefOid)"' 2>/dev/null); then
  strays=$(printf '%s\n' "$edges" | while read -r pr head head_sha base base_sha; do
    new_head=$(moved_to "$head")
    new_base=$(moved_to "$base")
    [ -n "$new_head$new_base" ] || continue
    h=${new_head:-$head_sha}
    # GitHub keeps a pull request's baseRefOid at the base it had when its own head was last pushed, so
    # a base an earlier push moved reads stale there and that base's own commits read as strays. The
    # base branch's head on the remote is what the pull request lists its commits against.
    b=${new_base:-$([ -z "$remote_url" ] || git ls-remote -q "$remote_url" "refs/heads/$base" 2>/dev/null | cut -f1)}
    b=${b:-$base_sha}
    fetch_missing "$h" "$b"
    if ! git cat-file -e "$h^{commit}" 2>/dev/null || ! git cat-file -e "$b^{commit}" 2>/dev/null; then
      echo "pre-push: $pr ($head) was not checked: its head or its base is not in this clone." >&2
      continue
    fi
    copy=$({ git log --format='%at %s' "$b..$h"; git log --format='%at %s' "$h..$b"; } | sort | uniq -d |
      head -1 | cut -d' ' -f2-)
    if [ -n "$copy" ]; then
      echo "warn $pr ($head) will list old copies of $base's commits as its own, among them \"$copy\"."
      if git merge-base --is-ancestor "$base_sha" "$h" 2>/dev/null; then
        from=$(git rev-parse --short=9 "$base_sha")
      else
        from="<the old $base it was built on>"
      fi
      echo "warn Replay it on its base before the stack lands, and each pull request above it in turn:"
      echo "warn   git rebase --onto $(git rev-parse --short=9 "$b") $from $(git rev-parse --short=9 "$h")"
    fi
    printf '%s\n' "$edges" | while read -r other other_head other_sha _ _; do
      o=$(moved_to "$other_head")
      o=${o:-$other_sha}
      [ "$other" != "$pr" ] && [ "$o" != "$b" ] || continue
      git merge-base --is-ancestor "$o" "$h" 2>/dev/null && ! git merge-base --is-ancestor "$o" "$b" 2>/dev/null ||
        continue
      echo "stop $pr ($head) would list $other's commits as its own: its head contains $other_head and its base"
      echo "stop $base does not. Base it there with gh pr edit ${pr#?} --base $other_head, or rebase it onto $base."
    done
  done)
  if printf '%s\n' "$strays" | grep -q '^warn '; then
    echo "pre-push: warning: this push leaves open pull requests listing old copies of their bases' commits." >&2
    printf '%s\n' "$strays" | sed -n 's/^warn /pre-push:   /p' >&2
  fi
  if printf '%s\n' "$strays" | grep -q '^stop '; then
    echo "pre-push: this push would leave open pull requests listing commits that are not theirs. Nothing was pushed." >&2
    printf '%s\n' "$strays" | sed -n 's/^stop /pre-push:   /p' >&2
    exit 1
  fi
else
  echo "pre-push: the open pull requests could not be read from GitHub, so the edge check was skipped." >&2
fi

if [ "$documentation_only" -eq 1 ]; then
  if [ "$documentation_diff_ok" -eq 0 ]; then
    echo "pre-push: documentation-only diff check failed; nothing was pushed." >&2
    exit 1
  fi
  echo "pre-push: documentation-only update; diff check passed and the full gate is skipped." >&2
  exit 0
fi

# Git exports repository-local variables to hooks. Test fixtures run nested `git init` commands;
# inheriting the outer GIT_DIR redirects those commands into this repository instead of the
# fixture. Resolve the root first, then give the gate an ordinary shell environment.
local_env=$(git rev-parse --local-env-vars)
[ -z "$local_env" ] || unset $local_env

if ! command -v bun >/dev/null 2>&1; then
  echo "pre-push: bun is not on PATH, so the repository gate could not run." >&2
  exit 1
fi

# The bytes under test are the pushed commit, and the hook says so, for any gate wrapper that tests
# a copy of HEAD rather than this working tree.
export ANA_TESTED_COMMIT="$tested_commit"

# A gate failure has to survive a truncated view of this hook's output. `git push … 2>&1 | tail -15`
# is the ordinary way an agent or a script runs a push, and it loses twice: the failing test scrolls
# past the kept window, and the pipeline reports tail's status, so an exit of 0 reads as a green
# push. The hook cannot change the caller's pipe, so it keeps the whole run in a file and repeats
# the failing lines at the very end, where the smallest tail still shows them.
gate_dir=$(git rev-parse --path-format=absolute --git-path ana-gate)
mkdir -p "$gate_dir"
log="$gate_dir/pre-push-$(date -u +%Y%m%dT%H%M%SZ)-$$.log"
status_file="$gate_dir/status.$$"

# Keep enough history to compare a failure with the run before it, and no more.
old_logs=$(ls -1t "$gate_dir"/pre-push-*.log 2>/dev/null | tail -n +11)
[ -z "$old_logs" ] || printf '%s\n' "$old_logs" | xargs rm -f

# A static step fails on the bytes the author wrote, never on the machine, so its findings go to the
# pusher one per line, `<rule> <location> <message>`, the rule in its tool's own spelling.
# A gate run under a terminal ends its log lines in CR and colours them; both go first.
static_findings() {
  tr -d '\r' <"$2" | sed "s/$(printf '\033')\[[0-9;]*m//g" | case "$1" in
  lint)
    sed -nE -e 's/^([^ ]+:[0-9]+:[0-9]+): (error|warning) ([A-Za-z0-9_@/-]+\([A-Za-z0-9_/-]+\)): (.*)/\3 \1 \4/p' \
      -e 's/^([^ ]+:[0-9]+:[0-9]+): warning: (Unused .*directive.*)/oxlint(unused-directive) \1 \2/p'
    ;;
  typecheck) sed -nE 's/^([^ ]+\([0-9]+,[0-9]+\)): error (TS[0-9]+): (.*)/\2 \1 \3/p' ;;
  source-policy) sed -nE 's/^([a-z]+(-[a-z]+)*): ([^ :]+): (.*)/source-policy(\1) \3 \4/p' ;;
  complexity) sed -nE 's/^  ([^ ]+) — (.*)/complexity(cyclomatic) \1 \2/p' ;;
  esac
}

# A pass that keeps its output in a log prints nothing for minutes, which reads exactly like a hung
# push, so each interval says how far the tests in that log have got. A failure the test wrapper has
# sent back for a rerun is not yet a verdict, so the pulse says when that rerun is under way, in the
# wrapper's own words for why. Only the wrapper's two rerun lines count: a `host-wall: error:` or
# `idle-wall: error:` line means the failures stand. The wrapper colours the line, so it is matched
# anywhere in the line rather than at its start. Killing the pulse's sleep ends its loop; the kill
# after it only covers a pulse caught between two sleeps.
pulse_seconds=${ANA_PUSH_PULSE_SECONDS:-60}
pulse() {
  started=$(date +%s)
  # The sleep holds none of the hook's output: one that outlives a pulse killed before it could
  # reap it would otherwise keep the push's stderr open until it woke.
  while sleep "$pulse_seconds" </dev/null >/dev/null 2>&1; do
    passed=$(grep -c '(pass)' "$2" 2>/dev/null) || true
    failed=$(grep -c '(fail)' "$2" 2>/dev/null) || true
    rerun=$(sed -n \
      -e 's/.*host-wall: \(.*\); running their .*/; \1, so the failed files are running again in one fresh process and that run decides/p' \
      -e 's/.*idle-wall: retrying \(.*\) one at a time .*/; the idle wall ended the suite, so its \1 are running again one at a time and that run decides/p' \
      "$2" 2>/dev/null | head -1) || true
    minutes=$(( ($(date +%s) - started) / 60 ))
    echo "pre-push: $1 still running after $minutes min: ${passed:-0} tests passed, ${failed:-0} failed so far$rerun." >&2
  done
}
stop_pulse() {
  pkill -P "$1" 2>/dev/null || true
  kill "$1" 2>/dev/null || true
  wait "$1" 2>/dev/null || true
}

# A push gates what it changed. A commit whose patch a branch it moves already held on the remote
# is a replay: a rebase carried it to a new base without changing what it does, so it waits for
# `bun run land`, which gates every commit where it sits before anything merges. That is what lets
# the pull request being worked on go up alone, or with the stack above it replayed, without paying
# for every commit above it. Every fresh commit gets the static steps and the tests near what it
# changed over a checkout of its own bytes, and the lowest pushed head holding the newest of them
# gets the whole gate, since that is the pull request the work is in. A push of replays alone runs
# no gate. A commit changing documentation alone has nothing for the static steps to read, and a
# commit that already passed the same pass, or the whole gate, in an earlier push or land from any
# worktree is not run again: a fix rewrites only its own commit and those after it, so after a
# failed push the commits beneath the fix keep their ids and their passes.
pass_record=$(git rev-parse --path-format=absolute --git-common-dir)/ana-gate-passed
earlier=$(git rev-list --reverse --topo-order $published --not $already_remote --remotes)
# `git patch-id` reads each commit's patch after the full object name `diff-tree --stdin` prints.
replaced=""
[ -z "$already_remote" ] || replaced=$(git rev-list $already_remote --not $published |
  git diff-tree --stdin -p --root | git patch-id --stable | cut -d' ' -f1)
patches=$(printf '%s\n' $earlier | git diff-tree --stdin -p --root | git patch-id --stable)
fresh=""
replays=0
for commit in $earlier; do
  if parent=$(git rev-parse -q --verify "$commit^1"); then
    changes_source "$parent" "$commit" || continue
  fi
  patch=$(printf '%s\n' "$patches" | awk -v commit="$commit" '$2 == commit { print $1 }')
  if [ -n "$patch" ] && printf '%s\n' "$replaced" | grep -qxF "$patch"; then
    replays=$((replays + 1))
    continue
  fi
  fresh="$fresh $commit"
done
[ "$replays" -eq 0 ] ||
  echo "pre-push: $replays commits replay ones the remote already held; bun run land gates them where they now sit." >&2

# The whole gate goes to the lowest pushed head holding the newest fresh commit; the checked-out tree
# holds every published commit, so it is that head when no pushed branch ends lower.
newest=""
for commit in $fresh; do newest=$commit; done
whole=""
if [ -n "$newest" ]; then
  for head in $heads $tested_commit; do
    git merge-base --is-ancestor "$newest" "$head" || continue
    [ -z "$whole" ] || git merge-base --is-ancestor "$head" "$whole" || continue
    whole=$head
  done
fi
if [ -z "$whole" ]; then
  echo "pre-push: no commit this push publishes is new to the remote, so no gate runs." >&2
  exit 0
fi
checked=""
skipped=0
for commit in $fresh; do
  [ "$commit" != "$whole" ] || continue
  if grep -qxF -e "$commit --at" -e "$commit --static" "$pass_record" 2>/dev/null; then
    skipped=$((skipped + 1))
    continue
  fi
  checked="$checked $commit"
done
if [ "$whole" != "$tested_commit" ]; then
  if grep -qxF "$whole --at" "$pass_record" 2>/dev/null; then
    skipped=$((skipped + 1))
  else
    checked="$checked $whole"
  fi
fi
[ "$skipped" -eq 0 ] || echo "pre-push: $skipped earlier commits already passed on these exact bytes; not run again." >&2
if [ -n "$checked" ]; then
  tree=$(mktemp -d "${TMPDIR:-/tmp}/ana-commit-gate.XXXXXX")
  git worktree add -q --detach "$tree" HEAD
  trap 'git worktree remove --force "$tree" >/dev/null 2>&1 || true' EXIT
  count=$(printf '%s\n' $checked | wc -l | tr -d ' ')
  index=0
  for commit in $checked; do
    index=$((index + 1))
    short=$(git rev-parse --short=9 "$commit")
    if [ "$commit" = "$whole" ]; then
      mode=--at what="the whole gate, as the head of the pull request this push changes"
    else
      mode=--static what="the static steps and its nearby tests"
    fi
    commit_log="$gate_dir/pre-push-$(date -u +%Y%m%dT%H%M%SZ)-$$-$short.log"
    echo "pre-push: commit $index of $count, $short: $what. Log: $commit_log" >&2
    git -C "$tree" checkout -q --detach "$commit"
    pulse "$short" "$commit_log" &
    pulse_pid=$!
    if ANA_TESTED_COMMIT="$commit" bun run gate "$mode" "$tree" >"$commit_log" 2>&1; then
      stop_pulse "$pulse_pid"
      echo "$commit $mode" >>"$pass_record"
      continue
    fi
    stop_pulse "$pulse_pid"
    failed_step=$(sed -n 's/^gate: step \([a-z-]*\) failed .*/\1/p' "$commit_log" | tail -1)
    findings=$(static_findings "$failed_step" "$commit_log" | head -50)
    {
      echo
      echo "pre-push: $short FAILS ${failed_step:-the gate} ON ITS OWN. Nothing was pushed."
      echo "pre-push: full output: $commit_log"
      if [ -n "$findings" ]; then printf '%s\n' "$findings"; else tail -30 "$commit_log"; fi
      echo "-------------------------------------------------------------------------------"
      echo "pre-push: every published commit must pass by itself, so the fix belongs in $short,"
      echo "pre-push: not in a commit on top. Stage it, then:"
      echo "pre-push:   git commit --fixup=$short"
      echo "pre-push:   GIT_SEQUENCE_EDITOR=true git rebase -i --autosquash $short~1"
      echo "pre-push: and push again. Later commits that conflict with the fix stop the rebase there."
    } >&2
    exit 1
  done
fi
[ "$whole" = "$tested_commit" ] || exit 0

# The tip's pass is remembered like a pushed head's, so a push its lease refused, or a branch sent
# again on its own, is not gated twice. The tip's gate runs over this working tree rather than a
# checkout of the commit, so a pass counts for the commit only when the tree held nothing else before
# the gate and after it.
if grep -qxF "$tested_commit --at" "$pass_record" 2>/dev/null; then
  echo "pre-push: $(git rev-parse --short=9 "$tested_commit") already passed the whole gate on these exact bytes; not run again." >&2
  exit 0
fi
uncommitted=$(git status --porcelain)
echo "pre-push: running bun run gate (runtime, typecheck, lint, tests)." >&2
set -- bun run gate

# `set -e` inside the group would skip the status line, and the pipeline's own status is tee's.
# Write the gate's exact exit code to a file instead of inferring it.
{ set +e; "$@"; echo $? >"$status_file"; } 2>&1 | tee "$log"
if [ -f "$status_file" ]; then status=$(cat "$status_file"); else status=1; fi
rm -f "$status_file"

if [ "$status" -eq 0 ]; then
  [ -n "$uncommitted$(git status --porcelain)" ] || echo "$tested_commit --at" >>"$pass_record"
  exit 0
fi

# gate.sh names a failed step in one spelling (`gate: step lint failed (exit 1)`); the tool's own
# lines before it are still worth repeating, since they name the file and the test: tsc `error
# TS2322`, oxlint `Found 3 errors`, `bun test` a `(fail) name` line and a ` 3 fail` summary, a
# refusing script Bun's lowercase `error: …`, `bun run` its `script "test" exited with code 1`.
failing=$(grep -nE '^gate: step .* failed|error TS[0-9]+|^\(fail\)|timed out after [0-9]+ms|^[[:space:]]*[0-9]+ fail$|^[[:space:]]*(FAIL|×|✗)|tests? failed|Found [0-9]+ (error|warning)|^[[:space:]]*[Ee]rror:|exited with code [1-9]' "$log" | tail -40)

failed_step=$(sed -n 's/^gate: step \([a-z-]*\) failed .*/\1/p' "$log" | tail -1)
short=$(git rev-parse --short=9 "$tested_commit")
static=0
findings=""
case "$failed_step" in
typecheck | lint | source-policy | complexity)
  static=1
  findings=$(static_findings "$failed_step" "$log" | head -50)
  ;;
esac

{
  echo
  echo "pre-push: THE GATE FAILED (exit $status). Nothing was pushed."
  echo "pre-push: full output: $log"
  if [ -n "$findings" ]; then
    echo "pre-push: $failed_step findings in $short (rule, location, message) ----------------"
    printf '%s\n' "$findings"
  elif [ -n "$failing" ]; then
    echo "pre-push: the failing lines ---------------------------------------------------"
    printf '%s\n' "$failing"
  else
    echo "pre-push: no step named a failure; the last 30 lines ---------------------------"
    tail -30 "$log"
  fi
  echo "-------------------------------------------------------------------------------"
  if [ "$static" -eq 1 ]; then
    echo "pre-push: YOUR PUSH DID NOT GO THROUGH: $failed_step failed on $short. Every published"
    echo "pre-push: commit must pass by itself, so the fix belongs in $short, not in a commit on top:"
    echo "pre-push:   git commit --amend   (with the fix staged), then push again."
  fi
  echo "pre-push: THE GATE FAILED (exit $status). Nothing was pushed. Log: $log"
} >&2

exit "$status"
