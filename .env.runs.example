# What your own machines hold, for `bun run runs`. Copy this file to `.env.runs`, which git
# ignores, and fill in your own. `bun run runs` loads it and `.env` by itself; another credentials
# file goes first, as `bun --env-file=<credentials> --env-file=.env.runs run runs status`.
# Copied as it stands, every setting is unset and the runs stay on this machine: uncomment what
# yours needs.
#
# The logins a run may take, by the N of CLAUDE_CODE_OAUTH_TOKEN<N> in the credentials file.
# Unset, every numbered login the credentials hold; with none, the plain CLAUDE_CODE_OAUTH_TOKEN.
# ANA_LOGINS=2,3

# The most live runs a login may carry, which `runs usage` prints beside each login's count of
# them on every host (`1/2 active`): a bare number for every login, `N:4` for login N on a larger
# plan, as `2,N:4`. Unset, it prints the count alone.
# ANA_LOGIN_RUNS=2

# Automatic fresh placement: the most live campaigns and simulation seats this machine may carry.
# Each peer's capacity is in its ANA_HOSTS entry. Both default to 2. An explicit --host overrides
# automatic placement; a remote receiver still rechecks its cap. Missing or malformed live counts
# refuse automatic placement.
# ANA_RUN_CAP=2

# The other machines that hold a worktree of this repository, reached over ssh. `runs status`
# adds each one's runs below this machine's, `runs hosts` shows theirs alone, and
# `runs on <name> <verb>` runs any verb there, and a verb that names a run (`stop`, `continue`,
# `keep`, `view` and the rest) goes to the host that holds it by itself. `tree`, `bun` and `envFiles` are paths on that
# machine, where `~` is its home; `envFiles` are loaded there and never copied. Each request runs
# from a clean detached controller at this checkout's published HEAD, prepared and installed once
# per commit. The configured tree stays in place. `packs` keeps a machine for those packs: `fresh`
# puts no other pack there and none of them anywhere else, chosen or named by --host. Unset or `[]`,
# `runs status` shows this machine alone. `checks` lets the check runner (tools/runtime/router)
# send that many check tasks there at once; a host without it runs no checks, and with none the
# checks run here.
# ANA_HOSTS='[{"name":"runner","ssh":"you@runner.local","tree":"~/src/anabasis","bun":"~/.bun/bin/bun","capacity":2,"checks":2,"envFiles":["~/src/anabasis/.env","~/src/anabasis/.env.runs"]}]'

# The machine that keeps the cycle's and the investigations' files, and whose daily
# `runs retire --yes` gathers every peer's records into data/runs/<host>/<name>: `here` on that
# machine, and its ANA_HOSTS name on the others, where the cycle script names it. Unset, nothing
# is named.
# ANA_CENTRAL=here

# Optional private transcript or memory roots for runs search, treated as notes by --in.
# JSON paths are local to each host; a leading ~ expands there. Keep real paths in .env.runs.
# Search uses the configured tree directly, with one request per host and no log copying.
# ANA_SEARCH_ROOTS='["~/path/to/records"]'
