#!/bin/sh
# When the push gate last failed here on a static step (typecheck, lint, source-policy,
# complexity), pre-push left its findings in ana-gate/fix-forward, headed by the commit it failed
# on. The commit made directly on top of that commit, or amending it, is the fix, so its message
# gets the findings as `Gate-Fix` and `Gate-Finding` trailers: the history then pairs each mistake
# with its repair, and `git log` counts the rules agents keep breaking (operator decision
# 2026-09-21). Every other commit is left alone.
set -eu

message=$1
pending=$(git rev-parse --git-path ana-gate/fix-forward)
[ -f "$pending" ] || exit 0
case "${2:-}" in merge | squash) exit 0 ;; esac
# A replayed pick is not the fix, even when it lands on the failing commit.
for state in CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply; do
  [ ! -e "$(git rev-parse --git-path "$state")" ] || exit 0
done
failed_on=$(head -1 "$pending")
[ "$(git rev-parse -q --verify HEAD || true)" = "$failed_on" ] || exit 0

set --
while IFS= read -r trailer; do
  set -- "$@" --trailer "$trailer"
done <<EOF
$(tail -n +2 "$pending")
EOF
git interpret-trailers --in-place --if-exists addIfDifferent "$@" "$message"
echo "prepare-commit-msg: this commit carries the gate findings from $(git rev-parse --short=9 "$failed_on")." >&2
