+static uint64_t esp32_sens_read(void *opaque, hwaddr addr, unsigned int size)
+{
+    Esp32GpioState *s = ESP32_GPIO(opaque);
+    uint32_t pads = extract32(s->sens_start1, 19, 12), ch = pads ? ctz32(pads) : 0;
+    if (addr != A_SENS_SAR_MEAS_START1) {
+        return 0; /* as the unimplemented SENS device this region overlays */
+    }
