#!/bin/sh
# Pre-push gate: validates outgoing commits via tools/runtime/pre-push.ts and marks pushed heads
# and downstream stacked PRs pending until `bun run land` proves the stack.
# Installed once per clone via `bun run hooks:install`, which sets `core.hooksPath` across worktrees.
set -eu
if ! command -v bun >/dev/null 2>&1; then
  echo "pre-push: bun is not on PATH, so the checks could not run. Nothing was pushed." >&2
  exit 1
fi
# Clear repository-local Git environment variables so scratch-worktree checks do not inherit GIT_DIR.
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars)
exec bun "$(dirname "$0")/../tools/runtime/pre-push.ts" "$@"
