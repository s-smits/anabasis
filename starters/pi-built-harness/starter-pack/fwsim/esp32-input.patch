+/*
+ * Without the "stimulus" property the model is the stock one: every register reads 0 except
+ * GPIO_STRAP and writes are dropped. With it, registers hold their values, GPIO_IN/GPIO_IN1 follow
+ * the stimulus on QEMU_CLOCK_VIRTUAL (deterministic under -icount), GPIO_PINn_INT_TYPE edges and
+ * levels set GPIO_STATUS and raise ETS_GPIO_INTR_SOURCE, and SENS_SAR_MEAS_START1 answers ADC1
+ * oneshot reads with the stimulus value of the selected channel. "<virtual_ns> quit" ends the run.
+ * Events apply on a fixed grid of stimulus-tick-ns: under -icount the round-robin vCPU timeslice
+ * is cut at the next virtual timer deadline, so a grid that does not depend on the event times
+ * keeps the guest's own timing independent of the stimulus schedule.
+ */
+typedef struct Esp32GpioEvent {
+    int64_t ns;
+    char kind; /* 'g'pio, 'a'dc1, 'q'uit */
+    uint32_t index, value;
+} Esp32GpioEvent;
+
+#define GPIO_REG(a) (s->regs[(a) >> 2])
+#define GPIO_BANK(pin, lo, hi) GPIO_REG((pin) < 32 ? (lo) : (hi))
+
+/* Pins of bank `hi` whose GPIO_PINn_INT_ENA field (bits 13..17) shares a bit with `ena`. */
+static uint32_t esp32_gpio_ena_mask(Esp32GpioState *s, int hi, uint32_t ena)
+{
+    uint32_t m = 0;
+    for (int i = 0; i < (hi ? 8 : 32); i++) {
+        if ((GPIO_REG(A_GPIO_PIN0 + 4 * (32 * hi + i)) >> 13) & ena) {
+            m |= 1u << i;
+        }
+    }
+    return m;
+}
+
+static void esp32_gpio_update(Esp32GpioState *s)
+{
+    for (int pin = 0; pin < 40; pin++) {
+        uint32_t type = extract32(GPIO_REG(A_GPIO_PIN0 + 4 * pin), 7, 3);
+        uint32_t level = extract32(GPIO_BANK(pin, A_GPIO_IN, A_GPIO_IN1), pin & 31, 1);
+        if (type == 4 + level) { /* 4: low level, 5: high level */
+            GPIO_BANK(pin, A_GPIO_STATUS, A_GPIO_STATUS1) |= 1u << (pin & 31);
+        }
+    }
+    /* APP CPU (bit 0) and PRO CPU (bit 2) maskable enables share ETS_GPIO_INTR_SOURCE */
+    qemu_set_irq(s->irq, (GPIO_REG(A_GPIO_STATUS) & esp32_gpio_ena_mask(s, 0, 5)) ||
+                         (GPIO_REG(A_GPIO_STATUS1) & esp32_gpio_ena_mask(s, 1, 5)));
+}
+
+static void esp32_gpio_set_input(Esp32GpioState *s, uint32_t pin, uint32_t level)
+{
+    uint32_t bit = 1u << (pin & 31), *in = &GPIO_BANK(pin, A_GPIO_IN, A_GPIO_IN1);
+    uint32_t type = extract32(GPIO_REG(A_GPIO_PIN0 + 4 * pin), 7, 3);
+    bool rose = level && !(*in & bit), fell = !level && (*in & bit);
+    *in = level ? *in | bit : *in & ~bit;
+    if ((rose && (type == 1 || type == 3)) || (fell && (type == 2 || type == 3))) {
+        GPIO_BANK(pin, A_GPIO_STATUS, A_GPIO_STATUS1) |= bit;
+    }
+    esp32_gpio_update(s);
+}

+static void esp32_gpio_stimulus_tick(void *opaque)
+{
+    Esp32GpioState *s = ESP32_GPIO(opaque);
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    while (s->next_event < s->n_events && s->events[s->next_event].ns <= now) {
+        Esp32GpioEvent *e = &s->events[s->next_event++];
+        trace_esp32_gpio_stimulus(now, e->kind, e->index, e->value);
+        if (e->kind == 'a') {
+            s->adc1[e->index] = e->value;
+        } else if (e->kind == 'g') {
+            esp32_gpio_set_input(s, e->index, e->value);
+        } else {
+            qemu_system_shutdown_request(SHUTDOWN_CAUSE_GUEST_SHUTDOWN);
+        }
+    }
+    timer_mod(s->timer, (now / s->tick_ns + 1) * s->tick_ns);
+}

