#!/usr/bin/env bash
# The one bun router, installed as ~/.local/bin/bun, first on PATH in every shell. It runs the Bun
# the tree pins (package.json "packageManager"), and sends Anabasis's check tasks to run.sh, which
# runs them on a host `ANA_HOSTS` lists (RUN_REMOTE). A Bun called by its full path bypasses both, so
# call plain `bun`. `bun tools/runtime/router/install.ts` installs a change, renaming new copies over
# the installed paths, and `--uninstall` puts back what the first install replaced.
#
# A tree is Anabasis's when it holds tools/runtime/gate.ts, the script of `bun run gate`. Until
# 25 October the test was a common Git folder of ~/Developer/anabasis, which the Linux host does
# not have; harness-builder-v4 shares the package name and has no gate.ts.
set -euo pipefail
runner_dir="$HOME/.local/share/ana-runner"
source "$runner_dir/lib.sh"
top="$(git rev-parse --show-toplevel 2>/dev/null || true)"

if [[ -z "${ANA_RUNNER_ACTIVE:-}" && -n "$top" && -f "$top/tools/runtime/gate.ts" ]]; then
  case "${1-}:${2-}" in
    test:*)
      shift
      exec "$runner_dir/run.sh" test "$@"
      ;;
    run:test | run:typecheck | run:lint | run:secrets | run:gate)
      task=$2
      shift 2
      [[ "${1-}" == "--" ]] && shift
      exec "$runner_dir/run.sh" "$task" "$@"
      ;;
  esac
fi
exec "$(pinned_bun "${top:-$PWD}")" "$@"
