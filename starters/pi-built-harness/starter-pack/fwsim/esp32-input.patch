 };

 static void esp32_gpio_reset_hold(Object *obj, ResetType type)
 {
+    Esp32GpioState *s = ESP32_GPIO(obj);
+    uint32_t in = GPIO_REG(A_GPIO_IN), in1 = GPIO_REG(A_GPIO_IN1);
+    memset(s->regs, 0, sizeof(s->regs));
+    GPIO_REG(A_GPIO_IN) = in; /* pin levels come from outside the chip */
+    GPIO_REG(A_GPIO_IN1) = in1;
+    qemu_set_irq(s->irq, 0);
 }

 static void esp32_gpio_realize(DeviceState *dev, Error **errp)
 {
+    Esp32GpioState *s = ESP32_GPIO(dev);
+    g_autofree char *text = NULL;
+    g_auto(GStrv) lines = NULL;
+    if (!s->stimulus) {
+        return;
+    }
+    if (strcmp(object_get_typename(OBJECT(dev)), TYPE_ESP32_GPIO) != 0) {
+        error_setg(errp, "%s: stimulus is modelled for the ESP32 only", object_get_typename(OBJECT(dev)));
+        return;
+    }
+    if (!g_file_get_contents(s->stimulus, &text, NULL, NULL)) {
+        error_setg(errp, "esp32.gpio: cannot read stimulus file %s", s->stimulus);
+        return;
+    }
+    lines = g_strsplit(text, "\n", -1);
+    s->events = g_new0(Esp32GpioEvent, g_strv_length(lines));
+    for (int i = 0; lines[i]; i++) {
+        Esp32GpioEvent *e = &s->events[s->n_events];
+        char kind[8];
+        int64_t ns;
+        uint32_t index = 0, value = 0;
+        int n;
+        g_strstrip(lines[i]);
+        if (!lines[i][0] || lines[i][0] == '#') {
+            continue;
+        }
+        n = sscanf(lines[i], "%" SCNd64 " %7s %" SCNu32 " %" SCNu32, &ns, kind, &index, &value);
+        if (!(n == 2 && strcmp(kind, "quit") == 0) &&
+            !(n == 4 && strcmp(kind, "gpio") == 0 && index < 40 && value < 2) &&
+            !(n == 4 && strcmp(kind, "adc1") == 0 && index < 8 && value < 4096)) {
+            n = -1;
+        }
+        if (n < 0 || ns < 0 || (s->n_events && ns < e[-1].ns)) {
+            error_setg(errp, "esp32.gpio: stimulus line %d is not '<ns> gpio <0-39> <0|1>', "
+                       "'<ns> adc1 <0-7> <0-4095>' or '<ns> quit' in time order: %s", i + 1, lines[i]);
+            return;
+        }
+        *e = (Esp32GpioEvent){ .ns = ns, .kind = kind[0], .index = index, .value = value };
+        s->n_events++;
+    }
+    if (!s->tick_ns) {
+        error_setg(errp, "esp32.gpio: stimulus-tick-ns must be positive");
+        return;
+    }
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, esp32_gpio_stimulus_tick, s);
+    timer_mod(s->timer, 0);
 }

