{
  "name": "anabasis",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#tools/*": "./tools/*",
    "#skills/*": "./.claude/skills/*"
  },
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "vendor/agent-bundle",
    "vendor/correctness-model-bundle",
    "vendor/correctness-model-prims"
  ],
  "engines": {
    "bun": "1.4.2"
  },
  "scripts": {
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "test": "bun tools/runtime/test-suite.ts",
    "lint": "bun tools/runtime/lint.ts",
    "simplify": "bun tools/oxlint/simplify-census.ts",
    "not-slop": "bun tools/oxlint/not-slop.ts",
    "format": "bun node_modules/@biomejs/biome/bin/biome format --write .",
    "format:check": "bun node_modules/@biomejs/biome/bin/biome format .",
    "login": "bun tools/login/cli.ts",
    "harness": "bun tools/harness/cli.ts",
    "outcome": "bun tools/outcome/cli.ts",
    "review:collect": "bun --no-env-file .claude/skills/whole-run-investigation/scripts/trace-review.mjs",
    "ui:dev": "cd packages/ui && bun run dev",
    "ui:build": "cd packages/ui && bun run build",
    "ui:deps": "bun install --frozen-lockfile --cwd packages/ui",
    "ui:gate": "bun run ui:deps && bun run ui:build && bun run test -- packages/ui/test",
    "replay": "bun tools/replay/cli.ts",
    "runs": "bun tools/runs/cli.ts",
    "triage": "bun tools/run-triage/cli.ts",
    "secrets": "bun tools/secrets/scan.ts",
    "hooks:install": "git config core.hooksPath .githooks",
    "gate": "bash tools/gate.sh",
    "fullrun": "bun src/run/full-run.ts"
  },
  "dependencies": {
    "@ana/agent-bundle": "0.0.0",
    "@ana/correctness-model-bundle": "0.0.0",
    "@ana/correctness-model-prims": "0.0.0",
    "@earendil-works/pi-agent-core": "0.87.0",
    "@earendil-works/pi-ai": "0.87.0",
    "@huggingface/transformers": "4.2.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "cc-session-io": "0.4.0",
    "change-case": "5.4.4",
    "claude-agent-sdk-bridge": "npm:@anthropic-ai/claude-agent-sdk@0.3.271",
    "diff": "^9.0.0",
    "typebox": "1.3.30",
    "typescript5": "npm:typescript@5.9.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@oxlint/plugins": "1.83.0",
    "@types/bun": "1.4.2",
    "@types/diff": "^8.0.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2"
  }
}
