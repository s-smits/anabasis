#!/bin/sh
# Pre-commit gate: delegates to tools/runtime/commit-check.sh (`bun run commit:check`).
# Installed once per clone via `bun run hooks:install`, which sets `core.hooksPath` across worktrees.
set -eu
if ! command -v bun >/dev/null 2>&1; then
  echo "pre-commit: bun is not on PATH, so the commit's checks could not run. Nothing was committed." >&2
  exit 1
fi
exec sh "$(dirname "$0")/../tools/runtime/commit-check.sh"
