# What your own machines hold, for `bun run runs`. Copy this file to `.env.runs`, which git
# ignores, and fill in your own. `bun run runs` loads it and `.env` by itself; another credentials
# file goes first, as `bun --env-file=<credentials> --env-file=.env.runs run runs status`.
# Copied as it stands, every setting is unset and the runs stay on this machine: uncomment what
# yours needs. With hosts listed, every remote verb carries `ANA_LOGINS`, `ANA_LOGIN_RUNS`,
# `ANA_LOGIN_SUBS` and `ANA_KEEP` with it, and each host's capacity, so a peer needs no copy of them;
# no credential goes with them, and a value that looks like one is refused.
#
# The logins a run may take, by the N of CLAUDE_CODE_OAUTH_TOKEN<N> in the credentials file.
# Unset, every numbered login the credentials hold; with none, the plain CLAUDE_CODE_OAUTH_TOKEN.
# ANA_LOGINS=2,3

# The most live runs a login may carry, which `runs usage` prints beside each login's count of
# them on every host (`1/2 active`): a bare number for every login, `N:4` for login N on a larger
# plan, as `2,N:4`. Unset, it prints the count alone. GPT runs are paid by each machine's own Codex
# login, `codex`, counted a machine and capped at one there unless `codex:N` names another.
# ANA_LOGIN_RUNS=2

# Each login's subscription: `max` or `ultra` for a Claude login, as `N:max,M:ultra`, and `pro100`
# or `pro200` for the Codex login, as `codex:pro100`. It sets the most live runs that login carries,
# one on `max`, two on `ultra` or `pro100` and four on `pro200` (the Codex login's a machine), wherever
# ANA_LOGIN_RUNS gives it no entry of its own, and `runs usage` and `runs active` print it. As a login's week nears its end,
# `usage` reads the most lower, to the runs what is left of the week fits, and a login carrying more
# than that reads oversubscribed.
# ANA_LOGIN_SUBS=2:max,3:ultra

# A run started on a numbered login gets a keeper, which goes on with it on another allowed login at a
# five-hour or weekly limit, so it spends on that login with nobody asked. Set to off for every run
# started from this machine, on a peer too. It ends no live keeper.
# ANA_KEEP=off

# Automatic fresh placement: the most live campaigns and simulation seats this machine may carry.
# Each peer's capacity is in its ANA_HOSTS entry. Both default to 2. An explicit --host overrides
# automatic placement; a remote receiver still rechecks its cap. Missing or malformed live counts
# refuse automatic placement.
# ANA_RUN_CAP=2

# The other machines that hold a worktree of this repository, reached over ssh. `runs status`
# adds each one's runs below this machine's, `runs hosts` shows theirs alone, and
# `runs on <name> <verb>` runs any verb there, and a verb that names a run (`stop`, `continue`,
# `keep`, `view` and the rest) goes to the host that holds it by itself. `tree`, `bun` and `envFiles` are paths on that
# machine, where `~` is its home; `envFiles` are loaded there and never copied. Each request runs
# from a clean detached controller at this checkout's published HEAD, prepared and installed once
# per commit. The configured tree stays in place. `packs` keeps a machine for those packs: `fresh`
# puts no other pack there and none of them anywhere else, chosen or named by --host. Unset or `[]`,
# `runs status` shows this machine alone. `checks` lets the check runner (tools/runtime/router)
# send that many check tasks there at once; a host without it runs no checks, and with none the
# checks run here. `settings` holds a host's own values of what a verb carries, over the shared ones,
# and an empty value sends none. `exclude` lists the rows of ANA_TOOLS a host keeps outside the table,
# reported and never changed, such as "some-tool" where its packages are older than the table.
# ANA_HOSTS='[{"name":"runner","ssh":"you@runner.local","tree":"~/src/anabasis","bun":"~/.bun/bin/bun","capacity":2,"checks":2,"envFiles":["~/src/anabasis/.env","~/src/anabasis/.env.runs"]}]'

# The machine kept for ablations and outside reads, by its name in ANA_HOSTS. `runs retire` on this
# machine then takes over each campaign that machine's own retire has archived (idle for a day):
# once the copy here matches the original byte for byte it joins this machine's archive and the
# original is deleted there, so that machine's disk stays free. A copy holds the record and each
# kept harness's own files, never the packages a seat installed, so a campaign taken over is read
# and no longer run. A campaign still in its worktree there stays. Unset or `here`, ablations run on this machine and retire deletes no original anywhere.
# ABLATION_HOST=runner

# The Python every machine keeps. `runs sync` has `uv` install this exact version under
# ~/.local/share/ana-python on each, which a seat's commands then find first, whatever package
# manager the host has. Unset, each machine keeps the python3 it has and `runs sync` only reports it.
# It uninstalls nothing, and refuses to move a machine with a live campaign unless --force.
# ANA_PYTHON=3.14.0

# Packages kept in that Python, by `name` or `name==version`, with pip checked present whenever any is
# named. Unset, none is enforced. A package nobody named is reported and stays.
# ANA_PYTHON_PACKAGES=uv==0.9.0

# The tools every machine keeps, one row each, as `bun run runs sync` reads and reports them. `read`
# is the shell that prints its version, by default `<tool> --version`, read in the order of the wall's
# path. `run` makes the tool do its job, and failing reads as drift at any version. `install` is the
# shell that brings a machine to the version; with none, drift is only reported. A change is refused
# under a live campaign on that host, since a seat would find it, unless the row says `"seats":false`
# or `--force` is given.
# ANA_TOOLS='{"some-tool":{"version":"1.2.3","read":"some-tool version","run":"some-tool check","install":"curl -fsSL https://example.org/install.sh | sh","seats":false}}'
