{
  "name": "anabasis",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#tools/*": "./tools/*",
    "#skills/*": "./.claude/skills/*"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "typecheck": "bun check",
    "test": "bun tools/runtime/test-suite.ts",
    "lint": "bun tools/runtime/lint.ts",
    "simplify": "bun tools/oxlint/simplify-census.ts",
    "not-slop": "bun tools/oxlint/not-slop.ts",
    "format": "bun node_modules/@biomejs/biome/bin/biome format --write .",
    "format:check": "bun node_modules/@biomejs/biome/bin/biome format .",
    "secrets": "bun tools/secrets/scan.ts",
    "runs": "bun --env-file=.env --env-file=.env.runs tools/runs/cli.ts",
    "commit:check": "sh tools/runtime/commit-check.sh",
    "gate": "bun tools/runtime/gate.ts",
    "hooks:install": "git config core.hooksPath .githooks && git config alias.complexity '!python3 .claude/skills/reduce-complexity/scripts/stack-complexity.py'",
    "land": "bun tools/runtime/land.ts",
    "follow": "bun .claude/skills/stack-pr/scripts/follow.ts",
    "ui:dev": "cd packages/ui && bun run dev",
    "ui:build": "cd packages/ui && bun run build",
    "ui:deps": "bun install --frozen-lockfile --cwd packages/ui",
    "ui:gate": "bun run ui:deps && bun run ui:build && bun run test -- packages/ui/test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.311",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "cross-spawn": "7.0.6",
    "diff": "8.0.4",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@oxlint/plugins": "1.83.0",
    "@types/bun": "1.4.3",
    "@types/cross-spawn": "^6.0.6",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2",
    "typescript5": "npm:typescript@5.9.3"
  }
}
