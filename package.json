{
  "name": "anabasis-v2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#tools/*": "./tools/*",
    "#skills/*": "./.claude/skills/*"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  },
  "scripts": {
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "test": "bun tools/runtime/test-suite.ts",
    "lint": "bun tools/runtime/lint.ts",
    "simplify": "bun tools/oxlint/simplify-census.ts",
    "not-slop": "bun tools/oxlint/not-slop.ts",
    "format": "bun node_modules/@biomejs/biome/bin/biome format --write .",
    "format:check": "bun node_modules/@biomejs/biome/bin/biome format .",
    "secrets": "bun tools/secrets/scan.ts",
    "runs": "bun tools/runs/cli.ts",
    "commit:check": "sh tools/runtime/commit-check.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.285",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@silvia-odwyer/photon-node": "0.3.4",
    "cross-spawn": "7.0.6",
    "diff": "8.0.4",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@oxlint/plugins": "1.83.0",
    "@types/bun": "1.4.2",
    "@types/cross-spawn": "^6.0.6",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2",
    "typescript5": "npm:typescript@5.9.3"
  }
}
